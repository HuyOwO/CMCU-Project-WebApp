# Copy file này thành ".env" rồi điền giá trị thật vào

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/dothatlac_hn?retryWrites=true&w=majority
JWT_SECRET=doi-chuoi-bi-mat-nay-thanh-chuoi-ngau-nhien-dai-hon
JWT_EXPIRE=30d
PORT=5000

# Danh sách domain frontend được phép gọi API (CORS), cách nhau bởi dấu phẩy
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# URL trang reset-password.html — dùng để build link trong email quên mật khẩu
CLIENT_RESET_URL=http://localhost:5500/reset-password.html

# (Tuỳ chọn) Gửi email thật qua Gmail — để trống thì API trả kèm devResetUrl để demo
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
